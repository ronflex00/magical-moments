{kind === 'party' && <svg viewBox="0 0 420 290" fill="none" role="img" aria-label="Une boule disco et une invitation secrète sur fond rétro orange">
  <g stroke="#b35e38" opacity=".35"><path d="M210 140 0 0m210 140L90 0m120 140L210 0m0 140L330 0M210 140 420 0m-210 140L420 140m-210 0L420 290m-210-150L210 290m0-150L0 290m210-150L0 140"/></g>
  <path d="M302 0v46" stroke="#613b47" stroke-width="2"/><circle cx="302" cy="89" r="44" fill="#e6b1ca" stroke="#653c50"/>
  <g class="preview-disco" data-ambient stroke="#93637c"><path d="M259 89h87M263 70h78m-78 38h78M280 51q-16 37 0 76m22-82v88m22-82q16 37 0 76"/></g><path d="m355 41 3 10 10 3-10 3-3 10-3-10-10-3 10-3ZM62 74l4 13 13 4-13 4-4 13-4-13-13-4 13-4Z" fill="#fff3ad"/>
