<div class="personal-playground" data-motion-scope>
  <div class="personal-art" style="--preview-color:#cf6c60">
    <span class="personal-note" aria-hidden="true">La recette ?<br /><em>Votre histoire.</em></span>
    <div class="paper-note" aria-live="polite" aria-atomic="true">
      <span>POUR QUELQU’UN D’UNIQUE</span>
      <strong class="preview-name">Pour Camille.</strong>
      <svg viewBox="0 0 100 90" width="77" height="68" aria-hidden="true"><path d="M50 80 14 46C-7 22 26-1 50 25 74-1 107 22 86 46Z" fill="var(--preview-color)"/></svg>
      <span class="preview-message">Tu rends les jours plus jolis.</span>
    </div>
    <span class="personal-sticker" aria-hidden="true" data-ambient>Juste<br />pour toi ♡</span>
  </div>
  <div class="preview-controls" aria-label="Essayez la personnalisation">
    <div class="preview-control-heading"><span>À VOUS DE JOUER</span><span aria-hidden="true">↗</span></div>
    <div class="preview-field"><label for="preview-first-name">Son prénom</label><input id="preview-first-name" class="preview-name-input" type="text" value="Camille" maxlength="24" autocomplete="off" /></div>
    <div class="preview-field"><label for="preview-note">Votre petit mot</label><select id="preview-note" class="preview-message-input"><option>Tu rends les jours plus jolis.</option><option>Aujourd’hui, la magie, c’est toi.</option><option>À nous et aux jours heureux.</option></select></div>
    <div class="preview-palettes" role="group" aria-label="La couleur de votre attention"><span>Sa couleur</span><button type="button" data-preview-color="#cf6c60" aria-label="Corail" aria-pressed="true" style="--swatch:#cf6c60"></button><button type="button" data-preview-color="#71855e" aria-label="Sauge" aria-pressed="false" style="--swatch:#71855e"></button><button type="button" data-preview-color="#ac6c88" aria-label="Rose" aria-pressed="false" style="--swatch:#ac6c88"></button></div>
    <p>Un aperçu à essayer, juste ici.</p>
  </div>
</div>
